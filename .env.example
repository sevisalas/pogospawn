# Baserow connection. Create a database token with read access to the table.
BASEROW_URL=https://api.baserow.io
BASEROW_TOKEN=
BASEROW_TABLE_ID=

# Baserow column names (or field IDs if user_field_names is disabled).
BASEROW_LAT_FIELD=latitude
BASEROW_LON_FIELD=longitude
BASEROW_SPECIES_FIELD=species
BASEROW_TIME_FIELD=timestamp
BASEROW_NAME_FIELD=name
